{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillProgram",
  "type": "object",
  "required": [
    "stages"
  ],
  "properties": {
    "maxRevisions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "operation": {
            "enum": [
              "inspect",
              "submit",
              "prepare",
              "execute",
              "review"
            ]
          },
          "toolIds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "inspectToolIds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "outputSchema": {
            "type": "object"
          },
          "checks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
