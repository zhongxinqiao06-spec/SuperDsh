      "name": "制作办公 PPT",
      "description": "策划叙事、品牌版式、图表与配图，生成可编辑 PPT。",
      "mode": "office",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
