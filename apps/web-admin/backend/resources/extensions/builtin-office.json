          },
          "revisionJson": {
            "type": "string",
            "maxLength": 200000,
            "description": "带baseHash和逐项修改的结构修订JSON。"
          },
          "dataAssetId": {
            "type": "string",
            "maxLength": 200
          },
          "templateAssetId": {
            "type": "string",
            "maxLength": 200
          },
          "attachmentName": {
            "type": "string",
            "maxLength": 255
          },
          "attachmentHash": {
            "type": "string",
            "maxLength": 64
          },
          "allowValueExtraction": {
            "type": "boolean",
