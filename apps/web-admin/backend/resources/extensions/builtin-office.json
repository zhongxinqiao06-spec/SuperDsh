          }
        }
      },
      "configurationSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "companyName": {
            "type": "string",
            "maxLength": 120,
            "title": "公司名称"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "title": "默认标题"
          },
          "designTheme": {
