{
  "connections": [
    {
      "id": "aliyun-token-plan",
      "name": "阿里云百炼 · Token Plan",
      "adapter": "openai-completions",
      "baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
      "enabled": true
    }
  ],
  "configurations": [
    {
      "id": "bailian-studio-image",
      "name": "百炼 · 角色与场景生图",
      "modelId": "qwen-image-3.0-pro",
      "capability": "image.generate",
      "connectionId": "aliyun-token-plan",
      "enabled": true,
      "parameters": {
        "imageProfile": "bailian-images",
        "size": "1536x1024",
        "maxImages": 3
      },
      "roleIds": []
    },
    {
      "id": "bailian-studio-research",
      "name": "百炼 · 联网资料查询",
      "modelId": "qwen3.8-flash",
      "capability": "web.search",
      "connectionId": "aliyun-token-plan",
      "enabled": true,
      "parameters": {
        "protocol": "responses",
        "maxTokens": 4096
      },
      "roleIds": []
    },
    {
      "id": "bailian-studio-video",
      "name": "百炼 · 动态镜头",
      "modelId": "happyhorse-1.1-t2v",
      "capability": "video.generate",
      "connectionId": "aliyun-token-plan",
      "enabled": true,
      "parameters": {},
      "roleIds": []
    },
    {
      "id": "bailian-studio-speech",
      "name": "百炼 · 角色配音",
      "modelId": "qwen-audio-3.0-tts-plus",
      "capability": "speech.synthesize",
      "connectionId": "aliyun-token-plan",
      "enabled": true,
      "parameters": {
        "voices": "longanhuan_v3.6,longanlingxin,longanlufeng"
      },
      "roleIds": []
    },
    {
      "id": "bailian-studio-reference",
      "name": "百炼 · 参考图动态镜头",
      "modelId": "happyhorse-1.1-r2v",
      "capability": "video.generate",
      "connectionId": "aliyun-token-plan",
      "enabled": true,
      "parameters": {
        "inputMode": "reference"
      },
      "roleIds": []
    }
  ],
  "defaults": {
    "web.search": "bailian-studio-research",
    "video.generate": "bailian-studio-video",
    "speech.synthesize": "bailian-studio-speech"
  }
}
