# syntax=docker/dockerfile:1
ARG NODE_IMAGE
ARG NGINX_IMAGE
FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 YARN_NETWORK_CONCURRENCY=2 npm_config_jobs=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ pkg-config && rm -rf /var/lib/apt/lists/* && corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/patches/ ./.yarn/patches/
COPY patches/ ./patches/
COPY vendor/ ./vendor/
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/desktop/package.json ./apps/desktop/package.json
COPY apps/desktop/ui/package.json ./apps/desktop/ui/package.json
COPY apps/desktop/core/package.json ./apps/desktop/core/package.json
COPY apps/desktop/plugins/harness/package.json ./apps/desktop/plugins/harness/package.json
COPY dsh-community-market/package.json ./dsh-community-market/package.json
COPY dsh-community-fabric/package.json ./dsh-community-fabric/package.json
RUN --mount=type=cache,target=/root/.yarn/berry/cache corepack yarn install --immutable
COPY upstream.json ./
COPY apps/web-admin/scripts/ ./apps/web-admin/scripts/
COPY apps/web-admin/contracts/ ./apps/web-admin/contracts/
COPY apps/web-admin/fronted/ ./apps/web-admin/fronted/
ARG SOURCE_COMMIT
ENV WEB_ADMIN_SOURCE_COMMIT=${SOURCE_COMMIT}
RUN node apps/web-admin/scripts/build-info.ts && node node_modules/vite/bin/vite.js build --config apps/web-admin/fronted/vite.config.ts

FROM ${NGINX_IMAGE} AS runtime
COPY apps/web-admin/deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web-admin/fronted/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD curl --fail http://127.0.0.1:8080/api/health/live || exit 1
