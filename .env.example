# Optional. The root docker compose up -d command also works with no .env.
WEB_ADMIN_FRONTED_PORT=5174
# Optional canonical public URL for OAuth and HTTPS, e.g. https://ai.example.com
WEB_ADMIN_PUBLIC_ORIGIN=

# Plain JSON read-only mount. On the server, set the path to the real model file.
WEB_ADMIN_MODEL_DEFAULTS_SOURCE=./apps/web-admin/deployment/model-defaults.json

# Keep an existing installation's PostgreSQL image and generated Compose secrets.
# WEB_ADMIN_IMAGE_POSTGRES=postgres:17-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
