# Optional overrides. docker compose up -d --build works without copying this file.
SUPERDSH_HTTP_PORT=5174
SUPERDSH_BIND_ADDRESS=0.0.0.0
TZ=Asia/Shanghai

# Empty means use the incoming HTTP host (works with your server IP).
# For an HTTPS reverse proxy, set the actual public URL, e.g. https://ai.example.com
SUPERDSH_PUBLIC_ORIGIN=
SUPERDSH_CORS_ORIGINS=

# Used only for the first account in an empty database. Empty password = generate.
SUPERDSH_INITIAL_ADMIN_USERNAME=admin
SUPERDSH_INITIAL_ADMIN_PASSWORD=

# Empty = generate once into the persistent config volume. Keep on updates.
POSTGRES_PASSWORD=

# Keep the variant that initialized your database. For a NEW database whose
# Alpine initdb fails with EPERM on an older host, see the deployment README.
SUPERDSH_POSTGRES_IMAGE=postgres:17-alpine

# Leave empty for a new deployment. Set only to restore the original keys.
AGENT_SERVER_SECRET=
SUPERDSH_MODEL_ENCRYPTION_KEY=
